# Regenerated by docket. Change the assignee below to your own handle.
filters:
  and:
    - or:
      - file.inFolder("DKT")
    - 'note.assignee == "agent/claude"'
    - 'note.status_category != "done"'
views:
  - type: table
    name: My tasks
    order:
      - note.key
      - note.title
      - note.status
      - note.priority
      - note.updated
