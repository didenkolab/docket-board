# Regenerated by docket. Projects are named explicitly; run
# "docket project add" to add one and rewrite these filters.
filters:
  and:
    - or:
      - file.inFolder("DKT")
    - 'note.status_category != "done"'
properties:
  note.title:
    displayName: Title
  note.assignee:
    displayName: Assignee
  note.priority:
    displayName: Priority
  note.tags:
    displayName: Tags
views:
  - type: cards
    name: Board
    groupBy:
      property: note.status
      direction: ASC
    order:
      - note.title
      - note.assignee
      - note.priority
      - note.labels
      - note.tags
